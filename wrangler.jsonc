{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "msihmmdi",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "6a23b3f0-9b37-4c9f-a9a4-09c18d70f308","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "47a87c5930ee44018978d2ca06ff6ac9" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
